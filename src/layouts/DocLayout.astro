---
import BaseLayout from "./BaseLayout.astro";
import Sidebar, { type NavItem } from "@/components/shared/Sidebar.astro";
import TableOfContents from "@/components/shared/TableOfContents.astro";
import Breadcrumbs, { type Crumb } from "@/components/shared/Breadcrumbs.astro";
import CopyMarkdownButton from "@/components/ui/CopyMarkdownButton.astro";
import SkillCopyWidget from "@/components/ui/SkillCopyWidget.astro";
import TagBadge from "@/components/ui/TagBadge.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AssetItem {
  label: string;
  file: string;
  size?: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  sidebarItems: NavItem[];
  basePath: "/docs" | "/brand";
  currentSlug: string;
  breadcrumbs?: Crumb[];
  category?: string;
  tags?: string[];
  author?: string;
  lastUpdated?: string;
  rawMarkdown?: string;
  skillName?: string;
  skillDescription?: string;
  skillBody?: string;
  cover?: string;
  assets?: AssetItem[];
  /** Tag counts map for tooltip: { [tag]: count } */
  tagCounts?: Record<string, number>;
}

const {
  title,
  description,
  headings,
  sidebarItems,
  basePath,
  currentSlug,
  breadcrumbs = [],
  category,
  tags = [],
  author,
  lastUpdated,
  rawMarkdown,
  skillName,
  skillDescription,
  skillBody,
  cover,
  assets = [],
  tagCounts = {},
} = Astro.props;

// Calculate Previous and Next pages
const currentIndex = sidebarItems.findIndex((item) => item.slug === currentSlug);
const prevItem = currentIndex > 0 ? sidebarItems[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < sidebarItems.length - 1 ? sidebarItems[currentIndex + 1] : null;

const section = basePath === "/docs" ? "docs" : "docs";
---

<BaseLayout title={`${title} | Dev Playbook`} description={description}>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col lg:flex-row gap-8">
      {/* Left Sidebar */}
      <Sidebar items={sidebarItems} basePath={basePath} currentSlug={currentSlug} />

      {/* Main Document Content Area */}
      <main class="min-w-0 flex-1 max-w-4xl py-2">
        {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

        {/* Document Header */}
        <header class="mb-8 pb-6 border-b border-border/80">

          {/* Category badge + Copy button row */}
          <div class="flex items-start justify-between gap-4 mb-3">
            <div class="flex items-center gap-2 flex-wrap">
              {category && (
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
                  {category}
                </div>
              )}
            </div>
            {/* Copy as Markdown — top-right of header */}
            {rawMarkdown && (
              <CopyMarkdownButton markdown={rawMarkdown} />
            )}
          </div>

          {/* Cover image */}
          {cover && (
            <div class="mb-6 overflow-hidden border border-border/60 bg-muted/20 aspect-[21/9] sm:aspect-[2.4/1] max-h-80">
              <img
                src={cover}
                alt={`${title} cover`}
                class="w-full h-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
          )}

          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
            {title}
          </h1>
          {description && (
            <p class="mt-3 text-base text-muted-foreground leading-relaxed">
              {description}
            </p>
          )}

          {/* Metadata badges */}
          {(author || lastUpdated || tags.length > 0) && (
            <div class="mt-4 flex flex-wrap items-center gap-3 pt-3 border-t border-border/50 text-xs text-muted-foreground">
              {author && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {author}
                </span>
              )}
              {lastUpdated && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Updated {lastUpdated}
                </span>
              )}

              {/* Tags — now using TagBadge with tooltips */}
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 ml-1">
                  {tags.map((tag) => (
                    <TagBadge
                      tag={tag}
                      count={tagCounts[tag]}
                      section={section}
                      crossSection={true}
                      asLink={true}
                    />
                  ))}
                </div>
              )}
            </div>
          )}
        </header>

        {/* Prose Body */}
        <article class="prose prose-slate dark:prose-invert max-w-none [&>h1:first-child]:hidden
          prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight
          prose-h1:text-2xl prose-h1:mt-8 prose-h1:mb-4
          prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b border-border/60 prose-h2:pb-2
          prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-relaxed prose-p:text-muted-foreground prose-p:my-4
          prose-a:text-primary prose-a:font-semibold hover:prose-a:underline prose-a:no-underline
          prose-code:text-foreground prose-code:bg-muted/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-xs prose-code:font-mono
          prose-pre:border prose-pre:border-border prose-pre:bg-muted/40 prose-pre:p-4
          prose-table:w-full prose-table:border-collapse prose-table:my-6
          prose-th:border prose-th:border-border prose-th:bg-muted/60 prose-th:p-2.5 prose-th:text-left prose-th:text-xs prose-th:font-semibold
          prose-td:border prose-td:border-border prose-td:p-2.5 prose-td:text-xs
          prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-muted/30 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:my-4
          prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6
          prose-ol:my-4 prose-ol:list-decimal prose-ol:pl-6
          prose-li:my-1.5 prose-li:text-muted-foreground">
          <slot />
        </article>

        {/* File Attachments Panel */}
        {assets.length > 0 && (
          <div class="mt-10 border border-border/60 bg-muted/20">
            <div class="px-4 py-3 border-b border-border/50 flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <h3 class="text-sm font-semibold text-foreground">Attachments</h3>
              <span class="ml-auto text-xs text-muted-foreground">{assets.length} file{assets.length !== 1 ? "s" : ""}</span>
            </div>
            <ul class="divide-y divide-border/40">
              {assets.map((asset) => (
                <li>
                  <a
                    href={asset.file}
                    download
                    class="group flex items-center gap-3 px-4 py-3 hover:bg-muted/40 transition-colors"
                  >
                    <svg class="w-4 h-4 text-muted-foreground shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors flex-1">
                      {asset.label}
                    </span>
                    {asset.size && (
                      <span class="text-xs text-muted-foreground">{asset.size}</span>
                    )}
                    <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Skill Copy Widget — Mobile fallback (below xl, above Prev/Next) */}
        {skillBody && skillName && (
          <div class="xl:hidden mt-8">
            <SkillCopyWidget
              skillName={skillName}
              skillDescription={skillDescription}
              skillBody={skillBody}
              variant="mobile"
            />
          </div>
        )}

        {/* Prev / Next Pagination */}
        {(prevItem || nextItem) && (
          <nav aria-label="Pagination" class="mt-12 pt-6 border-t border-border flex items-center justify-between gap-4">
            {prevItem ? (
              <a
                href={`${basePath}/${prevItem.slug}`}
                class="group flex flex-col p-4 border border-border/80 hover:border-primary/50 hover:bg-muted/30 transition-all text-left max-w-[48%]"
              >
                <span class="text-[11px] font-medium text-muted-foreground flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Previous
                </span>
                <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors truncate mt-1">
                  {prevItem.title}
                </span>
              </a>
            ) : <div />}

            {nextItem && (
              <a
                href={`${basePath}/${nextItem.slug}`}
                class="group flex flex-col p-4 border border-border/80 hover:border-primary/50 hover:bg-muted/30 transition-all text-right max-w-[48%]"
              >
                <span class="text-[11px] font-medium text-muted-foreground flex items-center justify-end gap-1">
                  Next
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
                <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors truncate mt-1">
                  {nextItem.title}
                </span>
              </a>
            )}
          </nav>
        )}
      </main>

      {/* Right Table of Contents */}
      <TableOfContents
        headings={headings}
        skillName={skillName}
        skillDescription={skillDescription}
        skillBody={skillBody}
      />
    </div>
  </div>
</BaseLayout>
