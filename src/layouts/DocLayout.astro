---
import BaseLayout from "./BaseLayout.astro";
import Sidebar, { type NavItem } from "@/components/shared/Sidebar.astro";
import TableOfContents from "@/components/shared/TableOfContents.astro";
import Breadcrumbs, { type Crumb } from "@/components/shared/Breadcrumbs.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  sidebarItems: NavItem[];
  basePath: "/docs" | "/brand";
  currentSlug: string;
  breadcrumbs?: Crumb[];
  category?: string;
  tags?: string[];
  author?: string;
  lastUpdated?: string;
}

const {
  title,
  description,
  headings,
  sidebarItems,
  basePath,
  currentSlug,
  breadcrumbs = [],
  category,
  tags = [],
  author,
  lastUpdated,
} = Astro.props;

// Calculate Previous and Next pages
const currentIndex = sidebarItems.findIndex((item) => item.slug === currentSlug);
const prevItem = currentIndex > 0 ? sidebarItems[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < sidebarItems.length - 1 ? sidebarItems[currentIndex + 1] : null;
---

<BaseLayout title={`${title} | Dev Playbook`} description={description}>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      {/* Left Sidebar */}
      <Sidebar items={sidebarItems} basePath={basePath} currentSlug={currentSlug} />

      {/* Main Document Content Area */}
      <main class="min-w-0 flex-1 max-w-4xl py-2">
        {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

        {/* Document Header */}
        <header class="mb-8 pb-6 border-b border-border/80">
          {category && (
            <div class="mb-2 inline-flex items-center gap-1.5 px-2.5 py-1  text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
              {category}
            </div>
          )}
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
            {title}
          </h1>
          {description && (
            <p class="mt-3 text-base text-muted-foreground leading-relaxed">
              {description}
            </p>
          )}

          {/* Metadata badges */}
          {(author || lastUpdated || tags.length > 0) && (
            <div class="mt-4 flex flex-wrap items-center gap-3 pt-3 border-t border-border/50 text-xs text-muted-foreground">
              {author && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {author}
                </span>
              )}
              {lastUpdated && (
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Updated {lastUpdated}
                </span>
              )}
              {tags.map((tag) => (
                <span class="px-2 py-0.5  bg-muted text-muted-foreground font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        {/* Prose Body */}
        <article class="prose prose-slate dark:prose-invert max-w-none 
          prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight
          prose-h1:text-2xl prose-h1:mt-8 prose-h1:mb-4
          prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-border/60 prose-h2:pb-2
          prose-h3:text prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-relaxed prose-p:text-muted-foreground prose-p:my-4
          prose-a:text-primary prose-a:font-semibold hover:prose-a:underline prose-a:no-underline
          prose-code:text-foreground prose-code:bg-muted/80 prose-code:px-1.5 prose-code:py-0.5 prose-code: prose-code:text-xs prose-code:font-mono
          prose-pre:border prose-pre:border-border prose-pre:bg-muted/40 prose-pre:-xl prose-pre:p-4
          prose-table:w-full prose-table:border-collapse prose-table:my-6
          prose-th:border prose-th:border-border prose-th:bg-muted/60 prose-th:p-2.5 prose-th:text-left prose-th:text-xs prose-th:font-semibold
          prose-td:border prose-td:border-border prose-td:p-2.5 prose-td:text-xs
          prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-muted/30 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:-r prose-blockquote:my-4
          prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6
          prose-ol:my-4 prose-ol:list-decimal prose-ol:pl-6
          prose-li:my-1.5 prose-li:text-muted-foreground">
          <slot />
        </article>

        {/* Prev / Next Pagination */}
        {(prevItem || nextItem) && (
          <nav aria-label="Pagination" class="mt-12 pt-6 border-t border-border flex items-center justify-between gap-4">
            {prevItem ? (
              <a
                href={`${basePath}/${prevItem.slug}`}
                class="group flex flex-col p-4 -xl border border-border/80 hover:border-primary/50 hover:bg-muted/30 transition-all text-left max-w-[48%]"
              >
                <span class="text-[11px] font-medium text-muted-foreground flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                  Previous
                </span>
                <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors truncate mt-1">
                  {prevItem.title}
                </span>
              </a>
            ) : <div />}

            {nextItem && (
              <a
                href={`${basePath}/${nextItem.slug}`}
                class="group flex flex-col p-4 -xl border border-border/80 hover:border-primary/50 hover:bg-muted/30 transition-all text-right max-w-[48%]"
              >
                <span class="text-[11px] font-medium text-muted-foreground flex items-center justify-end gap-1">
                  Next
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
                <span class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors truncate mt-1">
                  {nextItem.title}
                </span>
              </a>
            )}
          </nav>
        )}
      </main>

      {/* Right Table of Contents */}
      <TableOfContents headings={headings} />
    </div>
  </div>
</BaseLayout>
