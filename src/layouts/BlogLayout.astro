---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/shared/Breadcrumbs.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  image?: string;
}

const { title, description, pubDate, author = "Engineering Team", tags = [], image } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const breadcrumbs = [
  { label: "Blog", href: "/blog" },
  { label: title },
];
---

<BaseLayout title={`${title} | Dev Playbook Blog`} description={description}>
  <main class="mx-auto w-full max-w-4xl px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    {/* Magazine Article Header */}
    <header class="my-8 space-y-4 border-b border-border/80 pb-8">
      {tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 text-xs font-semibold bg-card border border-border/50">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-[1.15]">
        {title}
      </h1>

      {description && (
        <p class="text sm:text-xl text-muted-foreground leading-relaxed font-normal">
          {description}
        </p>
      )}

      <div class="flex items-center gap-4 pt-4 text-xs text-muted-foreground border-t border-border/40">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 -full bg-linear-to-tr from-primary to-emerald-400 flex items-center justify-center text-white font-bold text-xs shadow-xs">
            {author.charAt(0)}
          </div>
          <span class="font-medium text-foreground">{author}</span>
        </div>
        <span>•</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          4 min read
        </span>
      </div>
    </header>

    {image && (
      <div class="my-8 overflow-hidden border border-border">
        <img src={image} alt={title} class="w-full h-auto object-cover max-h-[420px]" />
      </div>
    )}

    {/* Editorial Article Body */}
    <article class="prose prose-slate dark:prose-invert max-w-none 
      prose-headings:font-bold prose-headings:tracking-tight
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:leading-relaxed prose-p:text-base prose-p:text-muted-foreground prose-p:my-4
      prose-a:text-primary prose-a:font-semibold hover:prose-a:underline prose-a:no-underline
      prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6
      prose-li:my-1.5 prose-li:text-muted-foreground">
      <slot />
    </article>

    {/* Back to Blog footer button */}
    <div class="mt-12 pt-8 border-t border-border flex justify-between items-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to all articles
      </a>
    </div>
  </main>
</BaseLayout>
