---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagBadge from "@/components/ui/TagBadge.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("showcase");

// Collect all unique tags with counts
const tagMap: Record<string, number> = {};
for (const project of projects) {
  for (const tag of project.data.tags ?? []) {
    tagMap[tag] = (tagMap[tag] ?? 0) + 1;
  }
}
const allTags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Project Showcase | Dev Playbook"
  description="Featured systems, internal platforms, and customer applications built according to our engineering standards."
>
  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 max-w-3xl">
      <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
        Project Showcase
      </h1>
      <p class="mt-4 text text-muted-foreground leading-relaxed">
        High-impact platforms and applications designed, engineered, and delivered according to our Playbook standards.
      </p>
    </div>

    {/* Tag Filter Bar */}
    {allTags.length > 0 && (
      <div class="mb-8 flex flex-wrap items-center gap-2" id="showcase-tag-filter-bar">
        <span class="text-xs font-semibold text-muted-foreground mr-1">Filter:</span>
        <button
          type="button"
          id="showcase-filter-clear-link"
          class="hidden inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium border border-border/50 bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        >
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Clear
        </button>
        {allTags.map(([tag, count]) => (
          <TagBadge tag={tag} count={count} section="showcase" asLink={true} />
        ))}
      </div>
    )}

    {/* Active filter banner */}
    <div
      id="showcase-active-filter-banner"
      class="hidden mb-8 flex items-center gap-3 px-4 py-3 bg-primary/5 border border-primary/20 text-sm"
    >
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
      </svg>
      <span class="text-foreground font-medium">
        Showing <span id="showcase-active-filter-count" class="text-primary font-bold">0</span> projects tagged
        <span id="showcase-active-filter-tag" class="font-bold"></span>
      </span>
      <a
        id="showcase-active-filter-cross-link"
        href="/tags/"
        class="ml-auto text-xs text-primary hover:underline font-medium whitespace-nowrap"
      >
        Search all sections →
      </a>
    </div>

    {/* Project Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="showcase-projects-grid">
      {projects.map((project) => (
        <article
          data-showcase-card
          data-tags={JSON.stringify(project.data.tags || [])}
          class="group border border-border/60 bg-card p-6 sm:p-8 hover:border-primary/50 transition-all flex flex-col justify-between"
        >
          <div>
            {project.data.image && (
              <a href={`/showcase/${project.id}`} class="block mb-5 overflow-hidden border border-border/60 aspect-video bg-muted/20">
                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  decoding="async"
                />
              </a>
            )}

            <div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
              <span class="font-semibold text-primary">{project.data.client || "Internal Project"}</span>
              {project.data.featured && (
                <span class="px-2 py-0.5 -full text-[10px] font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20">
                  Featured
                </span>
              )}
            </div>

            <h2 class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
              <a href={`/showcase/${project.id}`}>
                {project.data.title}
              </a>
            </h2>

            {project.data.description && (
              <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
                {project.data.description}
              </p>
            )}

            {project.data.techStack && project.data.techStack.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-5">
                {project.data.techStack.map((tech) => (
                  <span class="text-[11px] px-2 py-0.5  bg-muted text-muted-foreground font-medium">
                    {tech}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="mt-8 pt-4 border-t border-border/50 flex items-center justify-between">
            <a
              href={`/showcase/${project.id}`}
              class="text-xs font-semibold text-primary hover:underline flex items-center gap-1"
            >
              View Case Study
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            {project.data.link && (
              <a
                href={project.data.link}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-medium text-muted-foreground hover:text-foreground flex items-center gap-1"
              >
                External Link
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    {/* Empty state */}
    <div id="no-showcase-empty" class="hidden py-16 text-center text-muted-foreground">
      <p class="text-lg font-medium">No projects found for <span id="no-showcase-tag" class="text-foreground font-bold"></span></p>
      <button type="button" id="clear-showcase-filter-btn" class="mt-4 inline-block text-sm text-primary hover:underline cursor-pointer">
        Clear filter
      </button>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

    function getActiveTag() {
      return new URLSearchParams(window.location.search).get("tag") || "";
    }

    function applyShowcaseFilter(tag) {
      const cards = document.querySelectorAll("[data-showcase-card]");
      const banner = document.getElementById("showcase-active-filter-banner");
      const emptyState = document.getElementById("no-showcase-empty");
      const filterBadges = document.querySelectorAll("#showcase-tag-filter-bar .tag-badge");
      const clearBtn = document.getElementById("showcase-filter-clear-link");

      let visibleCount = 0;

      if (!tag) {
        cards.forEach((c) => c.classList.remove("hidden"));
        if (banner) banner.classList.add("hidden");
        if (emptyState) emptyState.classList.add("hidden");
        if (clearBtn) clearBtn.classList.add("hidden");
        filterBadges.forEach((b) => {
          b.classList.remove("bg-primary", "text-primary-foreground", "border-primary");
          b.classList.add("bg-muted", "text-muted-foreground", "border-border/50");
        });
        return;
      }

      cards.forEach((card) => {
        let cardTags = [];
        try {
          cardTags = JSON.parse(card.getAttribute("data-tags") || "[]");
        } catch (e) {}
        const match = cardTags.includes(tag);
        card.classList.toggle("hidden", !match);
        if (match) visibleCount++;
      });

      if (banner) {
        banner.classList.remove("hidden");
        const countEl = document.getElementById("showcase-active-filter-count");
        const tagEl = document.getElementById("showcase-active-filter-tag");
        const crossLink = document.getElementById("showcase-active-filter-cross-link");
        if (countEl) countEl.textContent = visibleCount;
        if (tagEl) tagEl.textContent = " #" + tag;
        if (crossLink) crossLink.href = "/tags/" + slugify(tag);
      }

      if (clearBtn) clearBtn.classList.remove("hidden");
      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
        const emptyTag = document.getElementById("no-showcase-tag");
        if (emptyTag) emptyTag.textContent = "#" + tag;
      }

      filterBadges.forEach((b) => {
        const bTag = b.getAttribute("data-tag");
        if (bTag === tag) {
          b.classList.add("bg-primary", "text-primary-foreground", "border-primary");
          b.classList.remove("bg-muted", "text-muted-foreground", "border-border/50");
        } else {
          b.classList.remove("bg-primary", "text-primary-foreground", "border-primary");
          b.classList.add("bg-muted", "text-muted-foreground", "border-border/50");
        }
      });
    }

    document.addEventListener("click", (e) => {
      const badge = e.target.closest(".tag-badge[data-tag]");
      if (badge) {
        const isShowcasePage = window.location.pathname.replace(/\/$/, "") === "/showcase";
        if (isShowcasePage) {
          e.preventDefault();
          const clickedTag = badge.getAttribute("data-tag");
          const current = getActiveTag();
          const nextTag = current === clickedTag ? "" : clickedTag;
          const newUrl = nextTag ? "/showcase?tag=" + encodeURIComponent(nextTag) : "/showcase";
          window.history.pushState({ tag: nextTag }, "", newUrl);
          applyShowcaseFilter(nextTag);
        }
      }

      if (e.target.closest("#showcase-filter-clear-link") || e.target.closest("#clear-showcase-filter-btn")) {
        e.preventDefault();
        window.history.pushState({ tag: "" }, "", "/showcase");
        applyShowcaseFilter("");
      }
    });

    window.addEventListener("popstate", () => {
      applyShowcaseFilter(getActiveTag());
    });

    applyShowcaseFilter(getActiveTag());
  })();
</script>
