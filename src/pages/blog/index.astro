---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Engineering Blog | Dev Playbook"
  description="Technical deep-dives, migration retrospectives, and architecture case studies."
>
  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 -full text-xs font-semibold bg-sky-500/10 text-sky-500 border border-sky-500/20 mb-4">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        Tech Insights
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
        Engineering Blog
      </h1>
      <p class="mt-4 text text-muted-foreground leading-relaxed">
        Lessons learned from scaling frontend apps, refactoring architectures, and adopting modern toolchains.
      </p>
    </div>

    {/* Blog Posts Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        });

        return (
          <article class="group border border-border/80 bg-card -2xl p-6 sm:p-8 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                <span class="font-medium">{post.data.author}</span>
              </div>
              <h2 class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground mt-3 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags?.slice(0, 3).map((tag) => (
                  <span class="text-[11px] px-2 py-0.5 -full bg-muted text-muted-foreground font-medium">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={`/blog/${post.id}`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline"
              >
                Read
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>
