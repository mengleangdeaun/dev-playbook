---
import { getCollection, getEntry, render } from "astro:content";
import DocLayout from "@/layouts/DocLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc, allDocs: docs },
  }));
}

const { doc, allDocs } = Astro.props;
const { Content, headings } = await render(doc);

// Sidebar items
const sidebarItems = allDocs.map((d) => ({
  title: d.data.title,
  slug: d.id,
  category: d.data.category,
  order: d.data.order,
}));

// Breadcrumbs
const breadcrumbs = [
  { label: "Docs", href: "/docs" },
  { label: doc.data.category || "General" },
  { label: doc.data.title },
];

// Skill — fetch linked skill entry if skillFile is set
let skillEntry: Awaited<ReturnType<typeof getEntry>> | undefined;
if (doc.data.skillFile) {
  skillEntry = await getEntry("skill", doc.data.skillFile);
}

// Tag counts — how many docs share each tag on this doc
const tagCounts: Record<string, number> = {};
for (const tag of doc.data.tags ?? []) {
  tagCounts[tag] = allDocs.filter((d) => d.data.tags?.includes(tag)).length;
}
---

<DocLayout
  title={doc.data.title}
  description={doc.data.description}
  headings={headings}
  sidebarItems={sidebarItems}
  basePath="/docs"
  currentSlug={doc.id}
  breadcrumbs={breadcrumbs}
  category={doc.data.category}
  tags={doc.data.tags}
  author={doc.data.author}
  lastUpdated={doc.data.lastUpdated}
  rawMarkdown={doc.body}
  skillName={skillEntry?.data.name}
  skillDescription={skillEntry?.data.description}
  skillBody={skillEntry?.body}
  cover={doc.data.cover}
  assets={doc.data.assets}
  tagCounts={tagCounts}
>
  <Content />
</DocLayout>
