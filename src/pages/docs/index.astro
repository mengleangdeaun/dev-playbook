---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagBadge from "@/components/ui/TagBadge.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("docs");
allDocs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Collect all unique tags with counts
const tagMap: Record<string, number> = {};
for (const doc of allDocs) {
  for (const tag of doc.data.tags ?? []) {
    tagMap[tag] = (tagMap[tag] ?? 0) + 1;
  }
}
const allTags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);

// Collect categories with counts
const categoryMap: Record<string, number> = {};
for (const doc of allDocs) {
  const cat = doc.data.category || "General";
  categoryMap[cat] = (categoryMap[cat] ?? 0) + 1;
}
const allCategories = Object.entries(categoryMap).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Documentation Hub | Dev Playbook"
  description="Engineering standards, setup manuals, framework decisions, and architectural guidelines."
>
  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header Section -->
    <div class="mb-10 max-w-3xl">
      <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
        Engineering Documentation
      </h1>
      <p class="mt-4 text-base text-muted-foreground leading-relaxed">
        Our core engineering playbook and guidelines for building resilient, performant, and consistent digital experiences.
      </p>
    </div>

    <!-- Featured Flagship Playbook Spotlight Banner -->
    <div id="featured-banner" class="mb-12 border border-primary/30 bg-linear-to-br from-primary/10 via-card to-background p-6 sm:p-8 relative overflow-hidden shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider bg-primary/20 text-primary border border-primary/30 mb-3">
          Flagship Playbook
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground">
          Frontend Engineering Playbook
        </h2>
        <p class="text-sm sm:text-base text-muted-foreground mt-3 leading-relaxed">
          The definitive guide to framework selection, feature-based architecture, state buckets, semantic design tokens, and Definition of Done PR checklists.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/docs/frontend-developer-playbook"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 shadow-xs transition-opacity"
          >
            Read Playbook
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <a href="/docs/frontend-developer-playbook" class="block overflow-hidden border border-border/80 aspect-video bg-muted/20 hover:border-primary/50 transition-colors group">
          <img
            src="/assets/images/docs/frontend-playbook-cover.svg"
            alt="Frontend Engineering Playbook cover"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="eager"
            decoding="async"
          />
        </a>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="mb-6 flex flex-wrap items-center gap-2" id="category-filter-tabs">
      <span class="text-xs font-semibold text-muted-foreground mr-1">Category:</span>
      <button
        type="button"
        data-category-tab=""
        class="category-tab-btn px-3 py-1 text-xs font-medium border border-primary bg-primary text-primary-foreground transition-all cursor-pointer"
      >
        All Docs ({allDocs.length})
      </button>
      {allCategories.map(([cat, count]) => (
        <button
          type="button"
          data-category-tab={cat}
          class="category-tab-btn px-3 py-1 text-xs font-medium border border-border/60 bg-muted/60 text-muted-foreground hover:text-foreground hover:border-border transition-all cursor-pointer"
        >
          {cat} ({count})
        </button>
      ))}
    </div>

    <!-- Tag Filter Bar -->
    {allTags.length > 0 && (
      <div class="mb-8 flex flex-wrap items-center gap-2" id="tag-filter-bar">
        <span class="text-xs font-semibold text-muted-foreground mr-1">Tags:</span>
        <button
          type="button"
          id="filter-clear-link"
          class="hidden inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium border border-border/50 bg-muted text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        >
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Clear
        </button>
        {allTags.map(([tag, count]) => (
          <TagBadge
            tag={tag}
            count={count}
            section="docs"
            asLink={true}
          />
        ))}
      </div>
    )}

    <!-- Active filter banner -->
    <div
      id="active-filter-banner"
      class="hidden mb-8 flex items-center gap-3 px-4 py-3 bg-primary/5 border border-primary/20 text-sm"
    >
      <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
      </svg>
      <span class="text-foreground font-medium">
        Showing <span id="active-filter-count" class="text-primary font-bold">0</span> docs
        <span id="active-filter-desc" class="font-bold"></span>
      </span>
      <a
        id="active-filter-cross-link"
        href="/tags/"
        class="ml-auto text-xs text-primary hover:underline font-medium whitespace-nowrap"
      >
        Search all sections →
      </a>
    </div>

    <!-- Unified Responsive Documentation Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="docs-grid">
      {allDocs.map((doc) => (
        <article
          data-doc-card
          data-category={doc.data.category || "General"}
          data-tags={JSON.stringify(doc.data.tags || [])}
          class="group border border-border/80 bg-card p-5 hover:border-primary/50 hover:shadow-md transition-all flex flex-col justify-between"
        >
          <div>
            {doc.data.cover && (
              <a href={`/docs/${doc.id}`} class="block mb-4 overflow-hidden border border-border/50 aspect-video bg-muted/20">
                <img
                  src={doc.data.cover}
                  alt={`${doc.data.title} cover`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  decoding="async"
                />
              </a>
            )}

            <div class="flex items-center justify-between text-xs text-muted-foreground mb-2">
              <span class="font-medium text-primary">{doc.data.category}</span>
            </div>
            <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
              <a href={`/docs/${doc.id}`}>
                {doc.data.title}
              </a>
            </h3>
            {doc.data.description && (
              <p class="text-xs text-muted-foreground line-clamp-2 mt-2 leading-relaxed">
                {doc.data.description}
              </p>
            )}
          </div>

          <div class="mt-5 pt-3 border-t border-border/50 flex items-center justify-between gap-2">
            {doc.data.tags && doc.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1">
                {doc.data.tags.slice(0, 2).map((tag) => (
                  <TagBadge
                    tag={tag}
                    count={tagMap[tag]}
                    section="docs"
                    asLink={true}
                  />
                ))}
              </div>
            )}
            <a
              href={`/docs/${doc.id}`}
              class="ml-auto inline-flex items-center gap-1 text-xs text-primary font-semibold hover:underline shrink-0"
            >
              Read
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state when no docs match filter -->
    <div id="no-docs-empty" class="hidden py-16 text-center text-muted-foreground">
      <p class="text-lg font-medium">No docs found matching your filter</p>
      <button type="button" id="clear-filter-btn" class="mt-4 inline-block text-sm text-primary hover:underline cursor-pointer">
        Clear all filters
      </button>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

    function getFilterParams() {
      const sp = new URLSearchParams(window.location.search);
      return {
        tag: sp.get("tag") || "",
        category: sp.get("category") || "",
      };
    }

    function setFilterUrl(tag, category) {
      const sp = new URLSearchParams();
      if (tag) sp.set("tag", tag);
      if (category) sp.set("category", category);
      const qs = sp.toString();
      const newUrl = qs ? "/docs?" + qs : "/docs";
      window.history.pushState({ tag, category }, "", newUrl);
    }

    function applyFilters() {
      const { tag, category } = getFilterParams();
      const cards = document.querySelectorAll("[data-doc-card]");
      const banner = document.getElementById("active-filter-banner");
      const featured = document.getElementById("featured-banner");
      const emptyState = document.getElementById("no-docs-empty");
      const filterBadges = document.querySelectorAll("#tag-filter-bar .tag-badge");
      const categoryTabs = document.querySelectorAll(".category-tab-btn");
      const clearBtn = document.getElementById("filter-clear-link");

      let visibleCount = 0;

      // Update category tab button active styles
      categoryTabs.forEach((tab) => {
        const tabCat = tab.getAttribute("data-category-tab") || "";
        const isActive = tabCat === category;
        if (isActive) {
          tab.classList.remove("bg-muted/60", "text-muted-foreground", "border-border/60");
          tab.classList.add("bg-primary", "text-primary-foreground", "border-primary");
        } else {
          tab.classList.add("bg-muted/60", "text-muted-foreground", "border-border/60");
          tab.classList.remove("bg-primary", "text-primary-foreground", "border-primary");
        }
      });

      // Update tag badge styles
      filterBadges.forEach((b) => {
        const bTag = b.getAttribute("data-tag");
        if (bTag === tag) {
          b.classList.add("bg-primary", "text-primary-foreground", "border-primary");
          b.classList.remove("bg-muted", "text-muted-foreground", "border-border/50");
        } else {
          b.classList.remove("bg-primary", "text-primary-foreground", "border-primary");
          b.classList.add("bg-muted", "text-muted-foreground", "border-border/50");
        }
      });

      // Filter individual cards
      cards.forEach((card) => {
        const cardCat = card.getAttribute("data-category") || "";
        let cardTags = [];
        try {
          cardTags = JSON.parse(card.getAttribute("data-tags") || "[]");
        } catch (e) {}

        const matchCat = !category || cardCat === category;
        const matchTag = !tag || cardTags.includes(tag);
        const isVisible = matchCat && matchTag;

        card.classList.toggle("hidden", !isVisible);
        if (isVisible) visibleCount++;
      });

      // Update active banner
      const hasFilter = tag || category;
      if (hasFilter) {
        if (banner) {
          banner.classList.remove("hidden");
          const countEl = document.getElementById("active-filter-count");
          const descEl = document.getElementById("active-filter-desc");
          const crossLink = document.getElementById("active-filter-cross-link");

          if (countEl) countEl.textContent = visibleCount;
          let desc = "";
          if (category && tag) desc = ` in "${category}" tagged #${tag}`;
          else if (category) desc = ` in category "${category}"`;
          else if (tag) desc = ` tagged #${tag}`;
          if (descEl) descEl.textContent = desc;

          if (crossLink) {
            if (tag) {
              crossLink.href = "/tags/" + slugify(tag);
              crossLink.classList.remove("hidden");
            } else {
              crossLink.classList.add("hidden");
            }
          }
        }
        if (featured) featured.classList.add("hidden");
        if (clearBtn) clearBtn.classList.remove("hidden");
      } else {
        if (banner) banner.classList.add("hidden");
        if (featured) featured.classList.remove("hidden");
        if (clearBtn) clearBtn.classList.add("hidden");
      }

      if (emptyState) {
        emptyState.classList.toggle("hidden", visibleCount > 0);
      }
    }

    // Intercept clicks on category tabs and tags
    document.addEventListener("click", (e) => {
      const catTab = e.target.closest(".category-tab-btn");
      if (catTab) {
        e.preventDefault();
        const clickedCat = catTab.getAttribute("data-category-tab") || "";
        const current = getFilterParams();
        const nextCat = current.category === clickedCat ? "" : clickedCat;
        setFilterUrl(current.tag, nextCat);
        applyFilters();
        return;
      }

      const badge = e.target.closest(".tag-badge[data-tag]");
      if (badge) {
        const isDocsPage = window.location.pathname.replace(/\/$/, "") === "/docs";
        if (isDocsPage) {
          e.preventDefault();
          const clickedTag = badge.getAttribute("data-tag");
          const current = getFilterParams();
          const nextTag = current.tag === clickedTag ? "" : clickedTag;
          setFilterUrl(nextTag, current.category);
          applyFilters();
          return;
        }
      }

      if (e.target.closest("#filter-clear-link") || e.target.closest("#clear-filter-btn")) {
        e.preventDefault();
        setFilterUrl("", "");
        applyFilters();
      }
    });

    window.addEventListener("popstate", () => {
      applyFilters();
    });

    applyFilters();
  })();
</script>
