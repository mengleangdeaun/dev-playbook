---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("docs");
allDocs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Group docs by category
const grouped = allDocs.reduce<Record<string, typeof allDocs>>((acc, doc) => {
  const cat = doc.data.category || "General";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(doc);
  return acc;
}, {});
---

<BaseLayout
  title="Documentation Hub | Dev Playbook"
  description="Engineering standards, setup manuals, framework decisions, and architectural guidelines."
>
  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 -full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-4">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        Technical Playbook
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
        Engineering Documentation
      </h1>
      <p class="mt-4 text text-muted-foreground leading-relaxed">
        Our core engineering playbook and guidelines for building resilient, performant, and consistent digital experiences.
      </p>
    </div>

    {/* Featured Doc Banner */}
    <div class="mb-12 -2xl border border-primary/30 bg-gradient-to-br from-primary/10 via-card to-background p-6 sm:p-8 relative overflow-hidden shadow-sm">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">
          Core Testing Document
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-foreground mt-2">
          Frontend Engineering Playbook
        </h2>
        <p class="text-sm sm:text-base text-muted-foreground mt-2 leading-relaxed">
          The definitive guide to framework selection, feature-based architecture, state buckets, semantic design tokens, and Definition of Done PR checklists.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/docs/frontend-developer-playbook"
            class="inline-flex items-center gap-2 px-5 py-2.5 -xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 shadow-xs transition-opacity"
          >
            Read Playbook
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* Categorized Documentation Grid */}
    <div class="space-y-10">
      {Object.entries(grouped).map(([category, docs]) => (
        <div>
          <h2 class="text-xl font-bold text-foreground mb-4 pb-2 border-b border-border flex items-center gap-2">
            <span class="w-2.5 h-2.5 -full bg-primary"></span>
            {category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {docs.map((doc) => (
              <a
                href={`/docs/${doc.id}`}
                class="group border border-border/80 bg-card -xl p-5 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between text-xs text-muted-foreground mb-2">
                    <span class="font-medium">{doc.data.category}</span>
                    {doc.data.tags && doc.data.tags.length > 0 && (
                      <span class="text-[10px] px-2 py-0.5 -full bg-muted">
                        {doc.data.tags[0]}
                      </span>
                    )}
                  </div>
                  <h3 class="text font-bold text-foreground group-hover:text-primary transition-colors">
                    {doc.data.title}
                  </h3>
                  {doc.data.description && (
                    <p class="text-xs text-muted-foreground line-clamp-2 mt-2 leading-relaxed">
                      {doc.data.description}
                    </p>
                  )}
                </div>
                <div class="mt-4 pt-3 border-t border-border/50 flex items-center justify-between text-xs text-primary font-medium">
                  <span>Read Guide</span>
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
