---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagBadge from "@/components/ui/TagBadge.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const [docs, blog, showcase] = await Promise.all([
    getCollection("docs"),
    getCollection("blog"),
    getCollection("showcase"),
  ]);

  // Collect every unique tag across all sections
  const tagSet = new Set<string>();
  [...docs, ...blog, ...showcase].forEach((entry) => {
    (entry.data.tags ?? []).forEach((t: string) => tagSet.add(t));
  });

  // Slugify the tag for the URL param — handles spaces, slashes, special chars
  // e.g. "UI/UX" → "ui-ux", "Dark Mode" → "dark-mode"
  const slugify = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  return Array.from(tagSet).map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, docs, blog, showcase },
  }));
}

// `tag` in props is the original (decoded) tag string passed from getStaticPaths
const { tag } = Astro.props as { tag: string; docs: any[]; blog: any[]; showcase: any[] };
const { docs, blog, showcase } = Astro.props as any;

const matchDocs = docs.filter((d: any) => d.data.tags?.includes(tag));
const matchBlog = blog.filter((b: any) => b.data.tags?.includes(tag));
const matchShowcase = showcase.filter((s: any) => s.data.tags?.includes(tag));
const total = matchDocs.length + matchBlog.length + matchShowcase.length;
---

<BaseLayout
  title={`#${tag} — Tag Search | Dev Playbook`}
  description={`${total} result${total !== 1 ? "s" : ""} across docs, blog, and showcase tagged "${tag}".`}
>
  <main class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-12">

    {/* Header */}
    <div class="mb-10">
      <a href="/docs" class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground mb-4 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Docs
      </a>
      <div class="flex items-center gap-3 mb-3">
        <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          #{tag}
        </h1>
      </div>
      <p class="text-muted-foreground">
        <span class="text-foreground font-semibold">{total}</span> result{total !== 1 ? "s" : ""} across all sections
      </p>
    </div>

    <div class="space-y-12">

      {/* Docs Section */}
      {matchDocs.length > 0 && (
        <section>
          <div class="flex items-center gap-2 mb-5 pb-2 border-b border-border">
            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <h2 class="text-lg font-bold text-foreground">Documentation</h2>
            <span class="ml-auto text-xs text-muted-foreground">{matchDocs.length} result{matchDocs.length !== 1 ? "s" : ""}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {matchDocs.map((doc: any) => (
              <article
                class="group border border-border/70 bg-card p-4 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="text-[11px] text-muted-foreground mb-1">{doc.data.category}</div>
                  <h3 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    <a href={`/docs/${doc.id}`} class="hover:underline focus:outline-none">
                      {doc.data.title}
                    </a>
                  </h3>
                  {doc.data.description && (
                    <p class="text-xs text-muted-foreground mt-1.5 line-clamp-2 leading-relaxed">
                      {doc.data.description}
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-border/40">
                  {doc.data.tags?.map((t: string) => (
                    <TagBadge tag={t} section="docs" asLink={true} active={t === tag} />
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* Blog Section */}
      {matchBlog.length > 0 && (
        <section>
          <div class="flex items-center gap-2 mb-5 pb-2 border-b border-border">
            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <h2 class="text-lg font-bold text-foreground">Blog Posts</h2>
            <span class="ml-auto text-xs text-muted-foreground">{matchBlog.length} result{matchBlog.length !== 1 ? "s" : ""}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {matchBlog.map((post: any) => (
              <article
                class="group border border-border/70 bg-card p-4 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="text-[11px] text-muted-foreground mb-1">
                    {post.data.pubDate?.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </div>
                  <h3 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    <a href={`/blog/${post.id}`} class="hover:underline focus:outline-none">
                      {post.data.title}
                    </a>
                  </h3>
                  {post.data.description && (
                    <p class="text-xs text-muted-foreground mt-1.5 line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-border/40">
                  {post.data.tags?.map((t: string) => (
                    <TagBadge tag={t} section="blog" asLink={true} active={t === tag} />
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* Showcase Section */}
      {matchShowcase.length > 0 && (
        <section>
          <div class="flex items-center gap-2 mb-5 pb-2 border-b border-border">
            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <h2 class="text-lg font-bold text-foreground">Showcase</h2>
            <span class="ml-auto text-xs text-muted-foreground">{matchShowcase.length} result{matchShowcase.length !== 1 ? "s" : ""}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {matchShowcase.map((project: any) => (
              <article
                class="group border border-border/70 bg-card p-4 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="text-[11px] text-muted-foreground mb-1">{project.data.client || "Internal Project"}</div>
                  <h3 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    <a href={`/showcase/${project.id}`} class="hover:underline focus:outline-none">
                      {project.data.title}
                    </a>
                  </h3>
                  {project.data.description && (
                    <p class="text-xs text-muted-foreground mt-1.5 line-clamp-2 leading-relaxed">
                      {project.data.description}
                    </p>
                  )}
                </div>
                <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-border/40">
                  {project.data.tags?.map((t: string) => (
                    <TagBadge tag={t} section="showcase" asLink={true} active={t === tag} />
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {/* Empty state */}
      {total === 0 && (
        <div class="py-20 text-center">
          <p class="text-muted-foreground text-lg">No results found for <span class="text-foreground font-bold">#{tag}</span></p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
