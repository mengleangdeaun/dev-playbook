---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const brandEntries = await getCollection("brand-guide");
brandEntries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="Brand Guidelines | Dev Playbook"
  description="Brand visual identity, OKLCH color tokens, typography scales, and logo assets."
>
  <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10 max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
        Brand Guidelines &amp; Design System
      </h1>
      <p class="mt-4 text text-muted-foreground leading-relaxed">
        Specifications for visual identity, digital assets, color token scales, and typography.
      </p>
    </div>

    {/* Brand Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {brandEntries.map((entry) => (
        <a
          href={`/brand/${entry.id}`}
          class="group border border-border/80 bg-card -2xl p-6 sm:p-8 hover:border-primary/50 hover:shadow transition-all flex flex-col justify-between"
        >
          <div>
            <span class="text-xs font-semibold text-primary uppercase tracking-wider">
              {entry.data.category}
            </span>
            <h2 class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors mt-2">
              {entry.data.title}
            </h2>
            {entry.data.description && (
              <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
                {entry.data.description}
              </p>
            )}
          </div>
          <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between text-sm font-semibold text-primary">
            <span>Explore Guidelines</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
