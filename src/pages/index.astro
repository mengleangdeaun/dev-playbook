---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("docs");
const allBrand = await getCollection("brand-guide");
const allBlog = await getCollection("blog");
const allShowcase = await getCollection("showcase");

allBlog.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allBlog.slice(0, 3);

// Interactive Code Console Snippets
const codeSnippets = {
  framework: `// 1. The 30-Second Architectural Decision Rule
export const selectFramework = (requirements: ProjectSpecs): TechStack => {
  if (requirements.isNativeMobile) {
    return { stack: "React Native (Expo)", render: "Native Runtime" };
  }
  if (!requirements.needsPublicSEO && requirements.isBehindLogin) {
    return { stack: "React 19 + Vite SPA", state: "TanStack Query" };
  }
  if (requirements.isContentFirst || requirements.isDocumentation) {
    return { stack: "Astro 5", render: "Zero-JS Static + Islands" };
  }
  return { stack: "Next.js (App Router)", render: "Hybrid RSC + SSR" };
};`,
  component: `// 2. Component Design Standards (Max 200 Lines Rule)
// Mandatory: Every async data component must handle all 4 states
export function InvoiceSummaryCard({ id }: { id: string }) {
  const { data: invoice, isPending, isError, refetch } = useInvoice(id);

  if (isPending) return <InvoiceSkeleton />;
  if (isError)   return <ErrorAlert onRetry={refetch} />;
  if (!invoice)  return <EmptyState message="No invoices recorded" />;

  return (
    <Card className="bg-card text-card-foreground border-border p-4">
      <CardTitle>{invoice.customerName}</CardTitle>
      <Badge variant="success">Paid \${invoice.amount}</Badge>
    </Card>
  );
}`,
  api: `// 3. Centralized Query Key Factory (Zero Magic Strings)
export const invoiceKeys = {
  all: ["invoices"] as const,
  lists: () => [...invoiceKeys.all, "list"] as const,
  list: (filter: Filters) => [...invoiceKeys.lists(), filter] as const,
  detail: (id: string) => [...invoiceKeys.all, "detail", id] as const,
};

// Strict Type-Safe API Fetcher with Zod schema validation
export const fetchInvoice = async (id: string): Promise<Invoice> => {
  const res = await apiClient.get(\`/api/invoices/\${id}\`);
  return InvoiceSchema.parse(res.data);
};`,
  tokens: `/* 4. Semantic OKLCH Tokens & Zero-Flicker Theme Switching */
:root {
  --background: oklch(97% 0 0);           /* Crisp off-white */
  --primary:    oklch(0.511 0.096 186.4);  /* Deep brand teal */
}

.dark {
  --background: oklch(0.148 0.004 228.8); /* Deep carbon */
  --primary:    oklch(0.704 0.140 182.5);  /* Luminous cyan (8.14:1 AAA) */
}

/* Freeze transitions during theme swap to eliminate component lag */
.theme-switching, .theme-switching * {
  transition: none !important;
}`,
};

const metrics = [
  { value: "100/100", label: "Core Web Vitals", detail: "Zero-JS baseline" },
  { value: "≤ 200", label: "Component Lines", detail: "Colocation rule" },
  { value: "Strict", label: "TypeScript + Zod", detail: "Zero 'any' policy" },
  { value: "AAA", label: "OKLCH Contrast", detail: "Zero-flicker themes" },
];

const decisionCards = [
  {
    id: "vite",
    title: "React (Vite SPA)",
    badge: "Client-Side Rendering",
    badgeColor: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20",
    question: "Is the application behind an authenticated login with complex interactive state?",
    bestFor: "Authenticated ERPs, CRM portals, internal admin dashboards, and POS systems.",
    stack: "Vite + React 19 + TanStack Query + Tailwind CSS + Shadcn UI",
    avoidWhen: "Public marketing pages that require dynamic Google SEO and rich OpenGraph link previews.",
  },
  {
    id: "next",
    title: "Next.js (App Router)",
    badge: "Hybrid RSC / SSR / PPR",
    badgeColor: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20",
    question: "Does the application require dynamic SEO, social link scraping, or edge middleware?",
    bestFor: "Customer-facing SaaS platforms, public marketplaces, and dynamic storefronts.",
    stack: "Next.js 15 (App Router) + React Server Components + Server Actions + Tailwind",
    avoidWhen: "Simple content blogs or private back-office systems where Node SSR servers add needless DevOps cost.",
  },
  {
    id: "astro",
    title: "Astro",
    badge: "Zero-JS Static + Islands",
    badgeColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    question: "Is the primary user activity reading content with fast initial page load?",
    bestFor: "Documentation hubs, developer handbooks, engineering blogs, and marketing landing pages.",
    stack: "Astro 5 + MDX + Tailwind CSS v4 + Isolated React Islands (client:idle)",
    avoidWhen: "Highly stateful single-page applications with complex persistent client-side routing.",
  },
  {
    id: "expo",
    title: "React Native (Expo)",
    badge: "Native Mobile Runtime",
    badgeColor: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20",
    question: "Does the product need native mobile hardware access (camera, biometrics, offline sync)?",
    bestFor: "Cross-platform iOS and Android production apps sharing TypeScript schemas with the web backend.",
    stack: "Expo SDK 52 + React Native + Expo Router + MMKV Storage",
    avoidWhen: "Standard desktop web browsers where standard responsive web apps suffice.",
  },
];

const guardrails = [
  {
    antiPattern: "Hype-driven framework picking based on resume trends",
    standard: "30-Second Architectural Decision Rule matching the real use case",
  },
  {
    antiPattern: "800-line monolithic components mixing state, layout, and fetch",
    standard: "Max 200 lines per file + strict colocation of hooks and types",
  },
  {
    antiPattern: "Sprinkling 'any' or skipping schema validation on API payloads",
    standard: "Strict TypeScript + Zod schema validation on all API responses",
  },
  {
    antiPattern: "Arbitrary hex colors (bg-[#1e293b]) and ad-hoc styling",
    standard: "Perceptual OKLCH semantic tokens with zero-flicker theme freezing",
  },
  {
    antiPattern: "Raw fetch inside useEffect with manual loading booleans",
    standard: "TanStack Query factories with typed keys and automated caching",
  },
];
---

<BaseLayout
  title="Dev Playbook | Engineering Standards & Architecture"
  description="Living engineering standards, architecture decision trees, brand guidelines, and developer handbook."
>
  <main class="min-h-screen bg-muted/40 dark:bg-[#08090b] text-foreground selection:bg-primary/20 selection:text-primary">
    
    {/* Continuous Vertical Border Frame Rails (Laravel / Render Architectural Style) */}
    <div class="max-w-7xl mx-auto border-x border-border bg-card dark:bg-[#0e1115] relative">
      
      {/* Background Blueprint Grid (Fades Downward) */}
      <div class="absolute inset-0 bg-grid-pattern bg-grid-fade opacity-35 dark:opacity-25 pointer-events-none"></div>

      {/* Hero Section */}
      <section class="relative border-b border-border">
        
      
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border relative">
          
          {/* Left Column (7 cols): Restrained Typography & Actions */}
          <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between relative">
            <div>
              {/* Disciplined, Clean Headline */}
              <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-foreground leading-[1.2]">
                Build Fast. Ship Clean. <br />
                <span class="text-primary">
                  Stay Resiliently Aligned.
                </span>
              </h1>

              {/* Concise Subhead */}
              <p class="mt-3 max-w-lg text-xs sm:text-[13px] text-muted-foreground leading-relaxed">
                The centralized engineering handbook for our team. Standardizing framework selection, 
                feature-driven folder structures, strict type contracts, semantic OKLCH tokens, and PR checklists.
              </p>

              {/* Action Buttons */}
              <div class="mt-6 flex flex-wrap items-center gap-2.5">
                <a
                  href="/docs/frontend-developer-playbook"
                  class="group inline-flex items-center gap-1.5 bg-primary text-primary-foreground px-3.5 py-1.5 text-xs font-semibold hover:opacity-90 transition-all cursor-pointer"
                >
                  <span>Open Architecture Guide</span>
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>

                <a
                  href="/brand"
                  class="inline-flex items-center gap-1.5 border border-border bg-background/80 px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted/60 transition-colors cursor-pointer"
                >
                  <span>Brand Guidelines</span>
                </a>
              </div>
            </div>

            {/* Quick architectural rules strip at base of column */}
            <div class="mt-8 pt-4 border-t border-border grid grid-cols-3 gap-3 text-[11px]">
              <div>
                <span class="block text-muted-foreground text-[10px] uppercase font-mono tracking-wider">Framework</span>
                <span class="font-mono font-semibold text-foreground text-xs">30-Sec Decision</span>
              </div>
              <div>
                <span class="block text-muted-foreground text-[10px] uppercase font-mono tracking-wider">Component</span>
                <span class="font-mono font-semibold text-foreground text-xs">≤ 200 Lines</span>
              </div>
              <div>
                <span class="block text-muted-foreground text-[10px] uppercase font-mono tracking-wider">Type Safety</span>
                <span class="font-mono font-semibold text-foreground text-xs">Strict + Zod</span>
              </div>
            </div>
          </div>

          {/* Right Column (5 cols): Developer Code Console */}
          <div class="lg:col-span-5 bg-card/40 flex flex-col justify-between">
            <div>
              {/* Console header */}
              <div class="flex items-center justify-between px-3.5 py-2 bg-muted/40 border-b border-border select-none">
                <div class="flex items-center gap-1.5">
                  <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                </div>
                <div class="text-[11px] font-mono text-muted-foreground font-medium flex items-center gap-1">
                  <span class="text-primary">●</span>
                  <span id="console-filename">framework.config.ts</span>
                </div>
                <button
                  type="button"
                  id="copy-snippet-btn"
                  class="text-[10px] font-mono text-muted-foreground hover:text-foreground flex items-center gap-1 transition-colors cursor-pointer"
                  title="Copy Code"
                >
                  <span id="copy-snippet-text">Copy</span>
                </button>
              </div>

              {/* Console Tab Pills */}
              <div class="flex border-b border-border bg-background/50 overflow-x-auto text-[11px] font-mono">
                <button
                  type="button"
                  class="console-tab-btn px-3 py-1.5 border-b-2 border-primary text-primary font-semibold bg-muted/20 cursor-pointer whitespace-nowrap"
                  data-tab="framework"
                  data-file="framework.config.ts"
                >
                  1. Framework
                </button>
                <button
                  type="button"
                  class="console-tab-btn px-3 py-1.5 border-b-2 border-transparent text-muted-foreground hover:text-foreground cursor-pointer whitespace-nowrap"
                  data-tab="component"
                  data-file="component-rules.tsx"
                >
                  2. 200 Lines
                </button>
                <button
                  type="button"
                  class="console-tab-btn px-3 py-1.5 border-b-2 border-transparent text-muted-foreground hover:text-foreground cursor-pointer whitespace-nowrap"
                  data-tab="api"
                  data-file="api-client.ts"
                >
                  3. Typed API
                </button>
                <button
                  type="button"
                  class="console-tab-btn px-3 py-1.5 border-b-2 border-transparent text-muted-foreground hover:text-foreground cursor-pointer whitespace-nowrap"
                  data-tab="tokens"
                  data-file="tokens.css"
                >
                  4. OKLCH
                </button>
              </div>

              {/* Code viewer */}
              <div class="p-3.5 bg-[#0c0e12] text-[#c9d1d9] font-mono text-[11px] leading-relaxed overflow-x-auto max-h-[290px]">
                <pre id="code-snippet-pre" class="m-0 p-0 bg-transparent text-inherit"><code>{codeSnippets.framework}</code></pre>
              </div>
            </div>

            <div class="px-3.5 py-1.5 bg-muted/30 border-t border-border flex items-center justify-between text-[11px] text-muted-foreground">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>TypeScript Strict &bull; Zero Any</span>
              </span>
              <a href="/docs/frontend-developer-playbook" class="text-primary hover:underline font-semibold text-xs">Playbook &rarr;</a>
            </div>
          </div>

        </div>
      </section>

      {/* Engineering Benchmarks Metric Strip (Framed Flush Grid) */}
      <section class="border-b border-border">
        <div class="grid grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-border">
          {metrics.map((m) => (
            <div class="p-6 sm:p-8 lg:p-10 hover:bg-muted/15 transition-colors">
              <div class="text-xl sm:text-2xl font-bold font-mono text-foreground tracking-tight">
                {m.value}
              </div>
              <div class="text-[10px] font-bold font-mono text-muted-foreground uppercase tracking-wider mt-1">
                {m.label}
              </div>
              <div class="text-[11px] text-muted-foreground/80 mt-0.5">
                {m.detail}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* The Four Core Pillars — Bento Grid Layout with Continuous Vertical Borders */}
      <section class="border-b border-border relative">
        <div class="py-4 sm:py-6 lg:py-8 px-6 sm:px-8 lg:px-10 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-primary tracking-tight">
              The Four Pillars of Engineering
            </h2>
          </div>
          <p class="text-xs text-muted-foreground max-w-sm leading-relaxed">
            Standardized principles and resources designed to prevent architectural fragmentation.
          </p>
        </div>

        {/* 4 Pillars Flush Grid with Continuous Vertical & Horizontal Dividers */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-border/80">
          
          {/* Pillar 1 */}
          <div class="p-6 flex flex-col justify-between hover:bg-muted/15 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-9 h-9 bg-primary/10 border border-primary/25 flex items-center justify-center text-primary">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-muted border border-border text-muted-foreground">
                  {allDocs.length} Docs
                </span>
              </div>
              <h3 class="text-sm font-bold text-foreground">Technical Docs</h3>
              <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">
                Framework decision trees, folder colocation patterns, 200-line rule, and PR checklists.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-border">
              <a href="/docs" class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1">
                Browse Docs &rarr;
              </a>
            </div>
          </div>

          {/* Pillar 2 */}
          <div class="p-6 flex flex-col justify-between hover:bg-muted/15 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-9 h-9 bg-amber-500/10 border border-amber-500/25 flex items-center justify-center text-amber-500">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-muted border border-border text-muted-foreground">
                  {allBrand.length} Guides
                </span>
              </div>
              <h3 class="text-sm font-bold text-foreground">Brand &amp; Tokens</h3>
              <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">
                Perceptual OKLCH palette tokens, Khmer typography, vector marks, and dark mode standards.
              </p>
              {/* Color Swatch Strip */}
              <div class="mt-3 flex items-center gap-1.5">
                <span class="h-3.5 w-6 border border-border bg-primary inline-block" title="Primary"></span>
                <span class="h-3.5 w-6 border border-border bg-[#090b0c] inline-block" title="Dark Canvas"></span>
                <span class="h-3.5 w-6 border border-border bg-[#161b1d] inline-block" title="Surface"></span>
                <span class="h-3.5 w-6 border border-border bg-rose-500 inline-block" title="Alert"></span>
              </div>
            </div>
            <div class="mt-6 pt-3 border-t border-border">
              <a href="/brand" class="text-xs font-semibold text-amber-500 hover:underline inline-flex items-center gap-1">
                Explore Brand &rarr;
              </a>
            </div>
          </div>

          {/* Pillar 3 */}
          <div class="p-6 flex flex-col justify-between hover:bg-muted/15 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-9 h-9 bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-500">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-muted border border-border text-muted-foreground">
                  {allBlog.length} Posts
                </span>
              </div>
              <h3 class="text-sm font-bold text-foreground">Engineering Blog</h3>
              <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">
                Production deployment retros, code-splitting audits, and theme architecture deep dives.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-border">
              <a href="/blog" class="text-xs font-semibold text-sky-500 hover:underline inline-flex items-center gap-1">
                Read Blog &rarr;
              </a>
            </div>
          </div>

          {/* Pillar 4 */}
          <div class="p-6 flex flex-col justify-between hover:bg-muted/15 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-9 h-9 bg-indigo-500/10 border border-indigo-500/25 flex items-center justify-center text-indigo-500">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-muted border border-border text-muted-foreground">
                  {allShowcase.length} Projects
                </span>
              </div>
              <h3 class="text-sm font-bold text-foreground">Project Showcase</h3>
              <p class="text-xs text-muted-foreground mt-1.5 leading-relaxed">
                Real-world ERPs, CRMs, and Telegram Mini Apps built adhering to this playbook.
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-border">
              <a href="/showcase" class="text-xs font-semibold text-indigo-500 hover:underline inline-flex items-center gap-1">
                View Showcase &rarr;
              </a>
            </div>
          </div>

        </div>
      </section>

      {/* Interactive 30-Second Framework Decision Rule (Framed Split Grid) */}
      <section class="border-b border-border relative">
        <div class="py-4 sm:py-6 lg:py-8 px-6 sm:px-8 lg:px-10 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-primary tracking-tight">
              The 30-Second Framework Decision Rule
            </h2>
          </div>
          <p class="text-xs text-muted-foreground max-w-sm leading-relaxed">
            Match your exact architectural scenario with our battle-tested toolchain.
          </p>
        </div>

        {/* 4 Clickable Scenarios Strip */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-border border-b border-border">
          {decisionCards.map((card, idx) => (
            <button
              type="button"
              class={`decision-card-btn text-left p-4 sm:p-5 transition-all cursor-pointer ${
                idx === 0 
                  ? "bg-primary/10 text-foreground font-semibold" 
                  : "hover:bg-muted/20 text-muted-foreground"
              }`}
              data-id={card.id}
            >
              <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 border ${card.badgeColor}`}>
                {card.badge}
              </span>
              <h4 class="font-bold text-xs text-foreground mt-2 mb-1">{card.title}</h4>
              <p class="text-[11px] text-muted-foreground leading-snug line-clamp-2">
                {card.question}
              </p>
            </button>
          ))}
        </div>

        {/* Detail Panel */}
        <div class="p-6 sm:p-8 bg-card/30">
          {decisionCards.map((card, idx) => (
            <div id={`detail-${card.id}`} class={`decision-detail ${idx === 0 ? "block" : "hidden"}`}>
              <div class="flex items-center justify-between pb-4 mb-5 border-b border-border">
                <div class="flex items-center gap-2.5">
                  <span class="h-2 w-2 rounded-full bg-primary"></span>
                  <h3 class="text-base font-bold text-foreground">{card.title}</h3>
                </div>
                <a
                  href="/docs/frontend-developer-playbook#1-framework-selection-matrix"
                  class="text-xs font-semibold text-primary hover:underline"
                >
                  Read Matrix Section &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-xs">
                <div>
                  <h5 class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground mb-1.5">When to Choose</h5>
                  <p class="text-foreground leading-relaxed">
                    {card.bestFor}
                  </p>
                </div>
                <div>
                  <h5 class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground mb-1.5">Standard Stack</h5>
                  <p class="font-mono text-primary leading-relaxed bg-primary/5 p-2.5 border border-primary/20 text-[11px]">
                    {card.stack}
                  </p>
                </div>
                <div>
                  <h5 class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted-foreground mb-1.5">When NOT to Use</h5>
                  <p class="text-muted-foreground leading-relaxed">
                    {card.avoidWhen}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* PR Quality Guardrails Table (Framed Side-by-Side) */}
      <section class="border-b border-border relative">
        <div class="py-4 sm:py-6 lg:py-8 px-6 sm:px-8 lg:px-10 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-primary tracking-tight">
              Strict Engineering Guardrails
            </h2>
          </div>
          <p class="text-xs text-muted-foreground max-w-sm leading-relaxed">
            Automate style with tooling; reserve code reviews for architecture and UX.
          </p>
        </div>

        <div class="divide-y divide-border">
          <div class="grid grid-cols-1 md:grid-cols-12 bg-muted/30 px-6 py-2.5 text-[11px] font-mono font-bold uppercase tracking-wider text-muted-foreground">
            <div class="md:col-span-5">Anti-Pattern (Reject PR)</div>
            <div class="hidden md:block md:col-span-2 text-center">&rarr;</div>
            <div class="md:col-span-5">Playbook Standard (Merge PR)</div>
          </div>

          {guardrails.map((g) => (
            <div class="grid grid-cols-1 md:grid-cols-12 px-6 py-3 items-center gap-2 hover:bg-muted/15 transition-colors text-xs">
              <div class="md:col-span-5 flex items-center gap-2 text-rose-500 font-medium">
                <span class="text-xs font-mono shrink-0">&times;</span>
                <span>{g.antiPattern}</span>
              </div>
              <div class="hidden md:flex md:col-span-2 justify-center text-[10px] font-mono text-muted-foreground">
                replaces
              </div>
              <div class="md:col-span-5 flex items-center gap-2 text-foreground font-semibold">
                <span class="text-xs font-mono text-primary shrink-0">&check;</span>
                <span>{g.standard}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Recent Engineering Articles (Framed Columns) */}
      {recentPosts.length > 0 && (
        <section class="border-b border-border relative">
          <div class="py-4 sm:py-6 lg:py-8 px-6 sm:px-8 lg:px-10 border-b border-border flex items-center justify-between gap-3">
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-primary tracking-tight">
                Latest Engineering Notes
              </h2>
            </div>
            <a
              href="/blog"
              class="text-xs font-semibold text-primary hover:underline inline-flex items-center gap-1"
            >
              <span>All Articles &rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-border">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="p-6 flex flex-col justify-between hover:bg-muted/15 transition-colors group"
              >
                <div>
                  <div class="flex items-center justify-between text-[11px] text-muted-foreground mb-2">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                    <span class="font-mono text-primary">4 min read</span>
                  </div>

                  <h3 class="text-sm font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    {post.data.title}
                  </h3>

                  {post.data.description && (
                    <p class="text-xs text-muted-foreground mt-2 line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                </div>

                <div class="mt-5 pt-3 border-t border-border flex items-center justify-between text-xs font-semibold text-primary">
                  <span>Read Article</span>
                  <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Modern Bottom Call to Action (Framed Banner) */}
      <section class="p-6 sm:p-10 relative overflow-hidden bg-muted/10">
        <div class="max-w-2xl">
          <h2 class="text-lg sm:text-xl font-bold text-primary tracking-tight">
            Build Fast. Ship Clean. Stay Aligned.
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
            Every pattern in this playbook is battle-tested across production web and mobile repositories. 
            Adopt the standards today to eliminate review friction.
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-2.5">
            <a
              href="/docs/frontend-developer-playbook"
              class="inline-flex items-center gap-1.5 bg-primary text-primary-foreground px-3.5 py-1.5 text-xs font-semibold hover:opacity-90 transition-opacity cursor-pointer"
            >
              <span>Read Architecture Playbook &rarr;</span>
            </a>

            <a
              href="/brand"
              class="inline-flex items-center gap-1.5 border border-border bg-background/80 px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted/60 transition-colors cursor-pointer"
            >
              <span>Brand Guidelines</span>
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>
</BaseLayout>

{/* Client Script for Interactive Console & Decision Finder */}
<script is:inline define:vars={{ codeSnippets }}>
  (function () {
    // 1. Interactive Code Console Switcher
    const consoleTabs = document.querySelectorAll(".console-tab-btn");
    const codePre = document.getElementById("code-snippet-pre");
    const filenameLabel = document.getElementById("console-filename");
    const copyBtn = document.getElementById("copy-snippet-btn");
    const copyText = document.getElementById("copy-snippet-text");

    let currentSnippet = codeSnippets.framework;

    consoleTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabKey = tab.getAttribute("data-tab");
        const filename = tab.getAttribute("data-file");

        // Update active tab styles
        consoleTabs.forEach((t) => {
          t.classList.remove("border-primary", "text-primary", "font-semibold", "bg-muted/20");
          t.classList.add("border-transparent", "text-muted-foreground");
        });
        tab.classList.remove("border-transparent", "text-muted-foreground");
        tab.classList.add("border-primary", "text-primary", "font-semibold", "bg-muted/20");

        // Update filename and code content
        if (filenameLabel) filenameLabel.textContent = filename || "";
        currentSnippet = codeSnippets[tabKey] || "";
        if (codePre) {
          const codeEl = codePre.querySelector("code");
          if (codeEl) codeEl.textContent = currentSnippet;
        }
      });
    });

    // Copy Button Handler
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(currentSnippet);
        if (copyText) copyText.textContent = "Copied!";
        setTimeout(() => {
          if (copyText) copyText.textContent = "Copy";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy snippet", err);
      }
    });

    // 2. Interactive Framework Decision Matrix Switcher
    const decisionButtons = document.querySelectorAll(".decision-card-btn");
    const decisionDetails = document.querySelectorAll(".decision-detail");

    decisionButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-id");

        // Update button states
        decisionButtons.forEach((b) => {
          b.classList.remove("bg-primary/10", "text-foreground", "font-semibold");
          b.classList.add("text-muted-foreground");
        });
        btn.classList.remove("text-muted-foreground");
        btn.classList.add("bg-primary/10", "text-foreground", "font-semibold");

        // Toggle details
        decisionDetails.forEach((detail) => {
          if (detail.id === `detail-${id}`) {
            detail.classList.remove("hidden");
            detail.classList.add("block");
          } else {
            detail.classList.remove("block");
            detail.classList.add("hidden");
          }
        });
      });
    });
  })();
</script>