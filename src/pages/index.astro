---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allDocs = await getCollection("docs");
const allBrand = await getCollection("brand-guide");
const allBlog = await getCollection("blog");
const allShowcase = await getCollection("showcase");

// Sort blog posts for recent updates
allBlog.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allBlog.slice(0, 3);

const pillars = [
  {
    title: "Core Technical Docs",
    href: "/docs",
    count: `${allDocs.length} Docs`,
    cta: "Browse Docs",
    accentBar: "group-hover:bg-primary",
    accentText: "text-primary",
    badgeBg: "bg-primary/10 text-primary border-primary/20",
    description:
      "Framework matrix (Vite vs Next vs Astro), colocation patterns, the 200-line rule, and PR checklists.",
    icon: `<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  {
    title: "Brand Guidelines",
    href: "/brand",
    count: `${allBrand.length} Guides`,
    cta: "Explore Identity",
    accentBar: "group-hover:bg-amber-500",
    accentText: "text-amber-500",
    badgeBg: "bg-amber-500/10 text-amber-500 border-amber-500/20",
    description:
      "Perceptual OKLCH palette tokens, typography scales, Khmer fonts, and vector assets.",
    icon: `<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.75" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />`,
  },
  {
    title: "Tech Blog",
    href: "/blog",
    count: `${allBlog.length} Posts`,
    cta: "Read Articles",
    accentBar: "group-hover:bg-sky-500",
    accentText: "text-sky-500",
    badgeBg: "bg-sky-500/10 text-sky-500 border-sky-500/20",
    description:
      "Deep dives, migration retrospectives, code-splitting tips, and engineering reflections.",
    icon: `<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.75" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />`,
  },
  {
    title: "Project Showcase",
    href: "/showcase",
    count: `${allShowcase.length} Projects`,
    cta: "View Projects",
    accentBar: "group-hover:bg-indigo-500",
    accentText: "text-indigo-500",
    badgeBg: "bg-indigo-500/10 text-indigo-500 border-indigo-500/20",
    description:
      "Real-world apps and internal systems built adhering to our playbook standards.",
    icon: `<path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.75" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  },
];

const frameworkMatrix = [
  {
    stack: "React (Vite SPA)",
    target: "Authenticated apps, internal portals, and dashboards behind login.",
    rendering: "Client CSR + TanStack Query",
  },
  {
    stack: "Next.js (App Router)",
    target: "Public SaaS, dynamic marketplaces, and rich SEO needs.",
    rendering: "Hybrid RSC + SSR",
  },
  {
    stack: "Astro",
    target: "High-speed documentation, blogs, and marketing sites.",
    rendering: "Zero-JS Static + Islands",
  },
];
---

<BaseLayout
  title="Dev Playbook | Engineering Standards & Architecture"
  description="The living developer playbook, architecture decision trees, brand guidelines, and engineering standards."
>
  <main class="relative min-h-screen bg-background text-foreground selection:bg-primary selection:text-primary">
    {/* Hero Section */}
    <section class="border-b border-border">
      <div class="mx-auto max-w-7xl px-4 pt-16 pb-16 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
          <div class="lg:col-span-8">
            <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-6xl sm:leading-[1.08]">
              Build Fast. Ship Clean. <br />
              <span class="text-primary">Stay Resiliently Aligned.</span>
            </h1>

            <p class="mt-6 max-w-2xl text-base sm:text-lg text-muted-foreground leading-relaxed">
              The unified engineering hub for our team. Standardizing framework selection, feature-based project architecture, semantic design tokens, and PR definitions of done.
            </p>

            {/* Action Buttons */}
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="/docs/frontend-developer-playbook"
                class="group inline-flex items-center gap-3 border border-primary bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <span>Open Frontend Playbook</span>
                <svg
                  class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="/brand/colors"
                class="group inline-flex items-center gap-3 border border-border/50 bg-card/50 px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:border-border hover:bg-muted/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <svg
                  class="h-4 w-4 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
                <span>Brand Guidelines</span>
              </a>
            </div>
          </div>

          {/* Right Column: PR Standards Summary */}
          <div class="lg:col-span-4 border border-border/40 bg-card/40 p-5">
            <div class="flex items-center justify-between border-b border-border/40 pb-3 mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-foreground">
                Core Standards
              </span>
              <span class="text-[11px] font-semibold text-emerald-500 bg-emerald-500/10 px-2 py-0.5">
                Active
              </span>
            </div>
            <ul class="space-y-2.5 text-xs text-muted-foreground">
              <li class="flex items-center justify-between py-1 border-b border-border/30">
                <span>Max Component Size</span>
                <span class="font-mono text-foreground font-semibold">&le; 200 Lines</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-border/30">
                <span>Type Safety</span>
                <span class="font-mono text-foreground font-semibold">Strict TS + Zod</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-border/30">
                <span>Required UI States</span>
                <span class="font-mono text-foreground font-semibold">Load / Empty / Err / OK</span>
              </li>
              <li class="flex items-center justify-between py-1">
                <span>Color Tokens</span>
                <span class="font-mono text-foreground font-semibold">Semantic OKLCH</span>
              </li>
            </ul>
          </div>
        </div>

        {/* Quick Stats Banner */}
        <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 border border-border/40 bg-card/40 divide-y sm:divide-y-0 sm:divide-x divide-border/40">
          <div class="p-5">
            <div class="text-3xl font-extrabold font-mono text-foreground">{allDocs.length}</div>
            <div class="text-xs font-medium text-muted-foreground mt-1">Core Docs &amp; Guides</div>
          </div>
          <div class="p-5">
            <div class="text-3xl font-extrabold font-mono text-foreground">{allBrand.length}</div>
            <div class="text-xs font-medium text-muted-foreground mt-1">Brand Guides</div>
          </div>
          <div class="p-5">
            <div class="text-3xl font-extrabold font-mono text-foreground">{allBlog.length}</div>
            <div class="text-xs font-medium text-muted-foreground mt-1">Articles &amp; Retros</div>
          </div>
          <div class="p-5">
            <div class="text-3xl font-extrabold font-mono text-foreground">{allShowcase.length}</div>
            <div class="text-xs font-medium text-muted-foreground mt-1">Project Showcases</div>
          </div>
        </div>
      </div>
    </section>

    {/* The 4 Main Pillars Section */}
    <section class="border-b border-border py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-primary">
              Playbook Architecture
            </h2>
            <p class="text-2xl sm:text-3xl font-extrabold text-foreground mt-1 tracking-tight">
              Four Pillars of Engineering
            </p>
          </div>
          <p class="text-sm text-muted-foreground max-w-md">
            Everything you need to ship world-class software at high velocity.
          </p>
        </div>

        {/* 4-Column Flush Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border border-border/40 bg-card/40 divide-y md:divide-y-0 md:divide-x divide-border/40">
          {pillars.map((pillar) => (
            <a
              href={pillar.href}
              class="group relative flex flex-col justify-between p-6 transition-colors hover:bg-muted/25 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
            >
              <div class={`absolute inset-x-0 top-0 h-0.5 bg-transparent transition-colors ${pillar.accentBar}`} />

              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class={`w-10 h-10 border flex items-center justify-center ${pillar.badgeBg}`}>
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      set:html={pillar.icon}
                      aria-hidden="true"
                    />
                  </div>
                  <span class="text-xs font-medium text-muted-foreground border border-border/40 px-2 py-0.5 bg-background/60">
                    {pillar.count}
                  </span>
                </div>

                <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors">
                  {pillar.title}
                </h3>

                <p class="text-xs text-muted-foreground mt-2 leading-relaxed">
                  {pillar.description}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-border/40 flex items-center justify-between text-xs font-semibold">
                <span class={pillar.accentText}>{pillar.cta}</span>
                <svg
                  class={`w-4 h-4 transition-transform group-hover:translate-x-1 ${pillar.accentText}`}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Decision Matrix Teaser Section */}
    <section class="border-b border-border py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">
            Key Standard
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground mt-1 tracking-tight">
            The 30-Second Framework Decision Rule
          </h2>
          <p class="text-sm text-muted-foreground mt-1">
            Never choose frameworks based on hype or resume building. Match your exact architectural requirement with the proven toolchain.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 border border-border/40 bg-card/40 divide-y lg:divide-y-0 lg:divide-x divide-border/40">
          {/* Left 7 Columns: Framework Matrix */}
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div class="divide-y divide-border/40">
              <div class="grid grid-cols-12 bg-muted/30 px-5 py-3 text-xs font-semibold text-muted-foreground">
                <div class="col-span-4">Framework</div>
                <div class="col-span-5">Best For</div>
                <div class="col-span-3 text-right">Rendering</div>
              </div>

              {frameworkMatrix.map((row) => (
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4 px-5 py-4 items-start sm:items-center hover:bg-muted/20 transition-colors">
                  <div class="sm:col-span-4 font-bold text-xs text-foreground flex items-center gap-2">
                    <span class="h-2 w-2 bg-primary inline-block shrink-0"></span>
                    {row.stack}
                  </div>
                  <div class="sm:col-span-5 text-xs text-muted-foreground leading-relaxed">
                    {row.target}
                  </div>
                  <div class="sm:col-span-3 sm:text-right">
                    <span class="inline-block border border-border/40 bg-background/60 px-2 py-1 font-mono text-[11px] text-foreground">
                      {row.rendering}
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <div class="border-t border-border/40 bg-muted/15 px-5 py-4 flex items-center justify-between">
              <a
                href="/docs/frontend-developer-playbook#1-framework-selection-matrix"
                class="group inline-flex items-center gap-2 text-xs font-semibold text-primary hover:underline"
              >
                <span>Read Framework Matrix in Detail</span>
                <svg
                  class="w-4 h-4 transition-transform group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          {/* Right 5 Columns: Code Highlight Snapshot */}
          <div class="lg:col-span-5 bg-muted/20 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between border-b border-border/40 bg-background/50 px-4 py-3 font-mono text-xs text-muted-foreground">
                <span>playbook-rules.ts</span>
              </div>

              <pre class="p-5 font-mono text-xs leading-relaxed overflow-x-auto text-muted-foreground"><span class="text-purple-400">export const</span> <span class="text-sky-400">coreStandards</span> = &#123;
  <span class="text-emerald-400">maxComponentLines</span>: <span class="text-amber-400">200</span>,
  <span class="text-emerald-400">strictTypeScript</span>: <span class="text-amber-400">true</span>,
  <span class="text-emerald-400">requireZodValidation</span>: <span class="text-amber-400">true</span>,
  <span class="text-emerald-400">statesRequired</span>: [
    <span class="text-teal-300">"loading"</span>,
    <span class="text-teal-300">"empty"</span>,
    <span class="text-teal-300">"error"</span>,
    <span class="text-teal-300">"success"</span>,
  ],
&#125;;</pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Recent Articles Teaser */}
    {recentPosts.length > 0 && (
      <section class="py-16">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-8 pb-4 border-b border-border/40">
            <div>
              <h2 class="text-xl font-bold text-foreground">Latest Engineering Notes</h2>
              <p class="text-xs text-muted-foreground mt-0.5">Fresh insights from our engineering teams</p>
            </div>
            <a
              href="/blog"
              class="group inline-flex items-center gap-2 border border-border/40 bg-card/40 px-4 py-2 text-xs font-semibold text-foreground hover:border-primary/60 hover:text-primary transition-colors"
            >
              <span>All Articles</span>
              <svg
                class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 border border-border/40 bg-card/40 divide-y md:divide-y-0 md:divide-x divide-border/40">
            {recentPosts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col justify-between p-6 hover:bg-muted/25 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
              >
                <div>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-xs text-muted-foreground"
                  >
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>

                  <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors mt-1.5 leading-snug">
                    {post.data.title}
                  </h3>

                  {post.data.description && (
                    <p class="text-xs text-muted-foreground mt-2 line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                </div>

                <div class="mt-6 pt-3 border-t border-border/30 flex items-center justify-between text-xs font-semibold text-primary">
                  <span>Read Article</span>
                  <svg
                    class="w-4 h-4 transition-transform group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>