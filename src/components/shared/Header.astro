---
import ThemeToggle from "./ThemeToggle.astro";
import { SearchModal, type SearchItem } from "./SearchModal";
import { getCollection } from "astro:content";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Build search items across collections
const allDocs = await getCollection("docs");
const allBrand = await getCollection("brand-guide");
const allBlog = await getCollection("blog");
const allShowcase = await getCollection("showcase");

const searchItems: SearchItem[] = [
  ...allDocs.map((d) => ({
    title: d.data.title,
    description: d.data.description,
    url: `/docs/${d.id}`,
    section: "Docs" as const,
    category: d.data.category,
  })),
  ...allBrand.map((b) => ({
    title: b.data.title,
    description: b.data.description,
    url: `/brand/${b.id}`,
    section: "Brand" as const,
    category: b.data.category,
  })),
  ...allBlog.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    url: `/blog/${p.id}`,
    section: "Blog" as const,
  })),
  ...allShowcase.map((s) => ({
    title: s.data.title,
    description: s.data.description,
    url: `/showcase/${s.id}`,
    section: "Showcase" as const,
  })),
];

const navLinks = [
  { label: "Docs", href: "/docs", active: currentPath.startsWith("/docs") },
  { label: "Brand Guide", href: "/brand", active: currentPath.startsWith("/brand") },
  { label: "Blog", href: "/blog", active: currentPath.startsWith("/blog") },
  { label: "Showcase", href: "/showcase", active: currentPath.startsWith("/showcase") },
];
---

<header class="sticky top-0 z-40 w-full border-b border-border/80 bg-background/80 backdrop-blur transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    {/* Left: Brand Logo */}
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary ">
        <div class="w-9 h-9 -xl bg-linear-to-br from-teal-500 to-emerald-600 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-base leading-none tracking-tight text-foreground flex items-center gap-1.5">
            Dev Playbook
          </span>
          <span class="text-[11px] text-muted-foreground font-medium tracking-wide">
            Engineering &amp; Brand
          </span>
        </div>
      </a>

      {/* Desktop Main Navigation */}
      <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-border/60">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-1.5  text-sm font-medium transition-colors ${
              link.active
                ? "bg-primary/10 text-primary font-semibold"
                : "text-muted-foreground hover:text-foreground hover:bg-muted/60"
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    {/* Right: Search, Theme Toggle, Mobile Menu Trigger */}
    <div class="flex items-center gap-2 sm:gap-3">
      {/* Search Modal React Island */}
      <SearchModal client:idle items={searchItems} />

      {/* Theme Toggle */}
      <ThemeToggle />

      {/* GitHub External link */}
      <a
        href="https://github.com"
        target="_blank"
        rel="noreferrer"
        class="hidden sm:inline-flex p-2 text-muted-foreground hover:text-foreground hover:bg-muted/60  transition-colors"
        aria-label="GitHub Repository"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      {/* Mobile Menu Button */}
      <button
        id="mobile-nav-toggle"
        type="button"
        class="md:hidden p-2 text-muted-foreground hover:text-foreground hover:bg-muted/60  transition-colors"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Nav Dropdown */}
  <div id="mobile-nav-panel" class="hidden md:hidden border-t border-border px-4 py-3 bg-card/95 backdrop-blur">
    <div class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`px-3 py-2  text-sm font-medium transition-colors ${
            link.active
              ? "bg-primary/10 text-primary font-semibold"
              : "text-muted-foreground hover:text-foreground hover:bg-muted"
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById("mobile-nav-toggle");
    const panel = document.getElementById("mobile-nav-panel");
    toggleBtn?.addEventListener("click", () => {
      panel?.classList.toggle("hidden");
    });
  })();
</script>
