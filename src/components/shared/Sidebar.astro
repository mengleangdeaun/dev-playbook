---
export interface NavItem {
  title: string;
  slug: string;
  category?: string;
  order?: number;
}

interface Props {
  items: NavItem[];
  basePath: "/docs" | "/brand";
  currentSlug?: string;
}

const { items, basePath, currentSlug } = Astro.props;

// Group items by category and sort by order
const grouped = items.reduce<Record<string, NavItem[]>>((acc, item) => {
  const cat = item.category || "General";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {});

// Sort categories and items within each category
Object.keys(grouped).forEach((cat) => {
  grouped[cat].sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
});
---

<aside class="w-full shrink-0 lg:w-64">
  <div class="sticky top-20 overflow-y-auto max-h-[calc(100vh-5.5rem)] pr-4 py-2">
    <div class="mb-4 pb-2 border-b border-border/60 flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
        {basePath === "/docs" ? "Documentation" : "Brand Guidelines"}
      </span>
      <span class="text-[11px] font-mono text-muted-foreground/80 px-1.5 py-0.5  bg-muted">
        {items.length} {items.length === 1 ? "doc" : "docs"}
      </span>
    </div>

    <nav class="space-y-6 text-sm">
      {Object.entries(grouped).map(([category, catItems]) => (
        <div>
          <h3 class="text-xs font-semibold text-foreground/90 uppercase tracking-wider mb-2 px-2">
            {category}
          </h3>
          <ul class="space-y-1">
            {catItems.map((item) => {
              const isActive = currentSlug === item.slug || currentSlug === `${basePath}/${item.slug}`;
              const href = `${basePath}/${item.slug}`;
              return (
                <li>
                  <a
                    href={href}
                    class={`group flex items-center justify-between px-3 py-1.5  text-xs font-medium transition-all ${
                      isActive
                        ? "bg-primary text-primary-foreground font-semibold shadow-xs"
                        : "text-muted-foreground hover:text-foreground hover:bg-muted/70"
                    }`}
                  >
                    <span class="truncate">{item.title}</span>
                    {isActive ? (
                      <span class="w-1.5 h-1.5 -full bg-white shrink-0"></span>
                    ) : (
                      <svg
                        class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-muted-foreground shrink-0"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</aside>
